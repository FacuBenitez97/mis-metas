# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore: NUNCA commitees el token real.

# Token del bot de Discord (Developer Portal -> tu app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Opcional pero MUY recomendado: limita el bot a estos servidores (IDs separados por coma).
# Vacío = el bot puede operar sobre cualquier servidor donde esté invitado.
DISCORD_ALLOWED_GUILDS=

# Opcional: limita qué grupos de herramientas se exponen (ver README del paquete).
# Vacío = todas las herramientas disponibles.
DISCORD_MCP_TOOLSETS=
